#!/usr/bin/env bash
# Stage isolated CircleCI coverage profiles and restore them for the final merge.

set -eo pipefail

readonly reports_directory="test/reports"
readonly workspace_directory="/tmp/abgleich-reports"
readonly action="$1"

case "$action" in
  stage)
    if [[ "$#" -ne 2 ]]; then
      printf '%s\n' 'coverage partition is required' >&2
      exit 1
    fi

    readonly partition="$2"

    case "$partition" in
      merges | commands | worker) ;;
      *)
        printf '%s\n' 'partition must be merges, commands, or worker' >&2
        exit 1
        ;;
    esac

    readonly destination="${workspace_directory}/${partition}"
    mkdir -p "$destination"
    [[ -d "$reports_directory" ]]

    for profile in "$reports_directory"/*.cov; do
      [[ -f "$profile" && ! -L "$profile" ]] || continue
      cp "$profile" "${destination}/${partition}-${profile##*/}"
    done
    ;;
  restore)
    if [[ "$#" -ne 1 ]]; then
      printf '%s\n' 'restore does not accept arguments' >&2
      exit 1
    fi

    mkdir -p "$reports_directory"
    find "$workspace_directory" -type f -name '*.cov' -exec cp {} "$reports_directory" \;
    ;;
  *)
    printf '%s\n' 'unknown coverage workspace action' >&2
    exit 1
    ;;
esac
